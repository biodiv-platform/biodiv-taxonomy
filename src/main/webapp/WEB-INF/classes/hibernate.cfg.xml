<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
	<session-factory>
		<property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
		<property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
		<property name="hibernate.connection.username">biodiv</property>
		<property name="hibernate.connection.password">prharasr</property>
		<property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/biodiv</property>

		<property name="hbm2ddl.auto">none</property>

		<property name="show_sql">false</property>

		<property name="hibernate.current_session_context_class">thread</property>
		<property name="hibernate.connection.provider_class">org.hibernate.hikaricp.internal.HikariCPConnectionProvider</property>

		<!-- Maximum waiting time for a connection from the pool (30 seconds) -->
		<property name="hibernate.hikari.connectionTimeout">30000</property>

		<!-- Minimum number of ideal connections in the pool -->
		<property name="hibernate.hikari.minimumIdle">5</property>

		<!-- Maximum number of actual connection in the pool -->
		<property name="hibernate.hikari.maximumPoolSize">30</property>

		<!-- Maximum time that a connection is allowed to sit idle in the pool (10 minutes) -->
		<property name="hibernate.hikari.idleTimeout">600000</property>

		<!-- Maximum lifetime of a connection in the pool (30 minutes) -->
		<property name="hibernate.hikari.maxLifetime">1800000</property>

		<!-- Connection leak detection threshold (10 seconds) -->
		<property name="hibernate.hikari.leakDetectionThreshold">10000</property>
		<property name="hibernate.jdbc.lob.non_contextual_creation">true</property>
		<property name="hibernate.id.db_structure_naming_strategy">legacy</property>


		<mapping class="com.strandls.taxonomy.pojo.TaxonomyDefinition" />
		<mapping class="com.strandls.taxonomy.pojo.TaxonomyRegistry" />
		<mapping class="com.strandls.taxonomy.pojo.SpeciesGroup" />
		<mapping class="com.strandls.taxonomy.pojo.SpeciesGroupMapping" />
		<mapping class="com.strandls.taxonomy.pojo.AcceptedSynonym" />
	</session-factory>
</hibernate-configuration>